# ─── Required ────────────────────────────────────────────────────────────
# Set EITHER OpenAI OR Anthropic (or both — OpenAI wins if both are present).
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

TAVILY_API_KEY=tvly-...

# ─── Optional: pin the provider ─────────────────────────────────────────
# Forces a specific provider regardless of which keys are present.
# Values: openai | anthropic
# LLM_PROVIDER=openai

# ─── Optional: per-role model overrides ─────────────────────────────────
# Each role resolves to the auto-selected provider's default if unset.
# Provider is inferred from the model-name prefix, so you can mix.
#
# OpenAI examples:
#   CLASSIFIER_MODEL=gpt-4.1-mini
#   WRITER_MODEL=gpt-4.1
#   SYNTHESIS_MODEL=gpt-4.1-mini
#
# Anthropic examples:
#   CLASSIFIER_MODEL=claude-haiku-4-5-20251001
#   WRITER_MODEL=claude-opus-4-7
#   SPECIALIST_MODEL=claude-sonnet-4-6

# ─── Optional: runtime limits ───────────────────────────────────────────
# DEEP_RESEARCH_MAX_ITER=2          # max architect→specialist→synthesis cycles
# SHALLOW_MAX_SEARCHES=3            # max searches for the shallow path
# SPECIALIST_RECURSION_LIMIT=18     # ReAct steps per specialist (covers search + extract calls)
